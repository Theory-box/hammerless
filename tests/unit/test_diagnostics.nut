assert(HLDBG.Disabled().reason=="disabled" && logs.len()==0);
assert(HLDBG.Watch(null,"first","hello\nworld",42,1).logged);
assert(logs[0].find("hello world: 42")!=null);
assert(HLDBG.Watch(null,"first","test",42,1).reason=="node interval");
local a={status="RUNNING",_stepSerial=7}, b={status="FAILED",_releasing=true};
assert(HLDBG.Watch(a,"same","A",1,1).logged);
assert(HLDBG.Watch(b,"same","B",1,1).logged);
assert(HLDBG.Inspect(a).running && HLDBG.Inspect(a).updates==7);
assert(HLDBG.Inspect(b).failed && HLDBG.Inspect(b).stopping);
assert(!HLDBG.Check(a,"check",false,false,"failure",1).passed);
assert(HLDBG.Check(a,"check",true,true,"failure",1).passed);
assert(HLDBG.Watch(a,"invalid","test",1,-1).reason=="invalid interval");
for(local i=0;i<20;++i) HLDBG.Watch(null,"limit"+i,"rate",i,0);
assert(logs.len()==20);
assert(HLDBG.Watch(null,"overflow","rate",0,0).reason=="global rate limit");
now=2;
assert(HLDBG.Watch(null,"first","again",1,0).logged);
assert(HLDBG.Watch(null,"first","again",1,0).suppressed);
assert(HLDBG.Text("x\ty\rz")=="x y z");
local longtext="";for(local i=0;i<1000;++i) longtext+="a";
assert(HLDBG.Text(longtext).len()==259);
local full={_diagnostics={}};
for(local i=0;i<128;++i) full._diagnostics["node"+i]<-0;
assert(HLDBG.Watch(full,"extra","cap",1,1).reason=="state capacity");
now=400;
assert(HLDBG.Watch(null,"fresh","fresh",1,1).logged && HLDBG.nodes.len()==1);
now=0;
assert(HLDBG.Watch(null,"fresh","rollback",1,1).logged);
local bot1={GetEntityIndex=function(){return 1;}}, bot2={GetEntityIndex=function(){return 2;}};
local loopctx={bot=bot1,loop={},loopid="patrol"};
assert(HLDBG.Watch(loopctx,"node","loop",1,1).logged);
assert(!("_diagnostics" in loopctx));
assert(HLDBG.Watch({bot=bot1,loop={},loopid="patrol"},"node","loop",1,1).suppressed);
assert(HLDBG.Watch({bot=bot2,loop={},loopid="patrol"},"node","loop",1,1).logged);
assert(HLDBG.Watch({bot=bot1,loop={},loopid="other"},"node","loop",1,1).logged);
