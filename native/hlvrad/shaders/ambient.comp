#version 460
#extension GL_GOOGLE_include_directive : require
// Leaf ambient cubes (leafambient.c's AmbientFromSphericalSamples, without the surface lights, which the CPU adds): per
// point, what 162 rays find (CalcRayAmbientLighting: lightmaps times reflectivity, or the sky), then the cube's 6 sides.
// Out: 18 floats per point.
layout(local_size_x = 64) in;
#include "walk.glsl"
layout(set = 0, binding = 15, std430) readonly buffer SkyMap { float skymap[]; };
layout(set = 0, binding = 16, std430) readonly buffer Dirs { vec4 anorms[]; };
layout(set = 0, binding = 17, std430) readonly buffer Points { float points[]; };
layout(set = 0, binding = 18, std430) writeonly buffer Out { float outv[]; };
layout(push_constant) uniform PC {
    int npoints, haveSkyMap, skymapW, skymapH;
    vec4 skylight;          // the sky ambient light's colour; w: 1 when there is one
    int fix;                // -fixquirks
} pc;
#include "skymap.glsl"

const float RAY_LENGTH = 2.0 * 16384.0 * 1.74;
const float TAN_THETA = 0.12765948;     // ((float)tan(7.275 degrees))

vec3 SkyColor(vec3 dir) {
    if (pc.haveSkyMap != 0) return SkyMapColor(dir, Luminance(pc.skylight.xyz), pc.skymapW, pc.skymapH);
    return pc.skylight.xyz;
}

// AmbientFromSurface: a sky face's light is the sky's; a lit face's, its lightmap times its reflectivity
vec3 FromSurface(int f, vec3 c, vec3 dir) {
    if ((faces[f].b.w & SURF_SKY) != 0) return pc.skylight.w != 0.0 ? SkyColor(dir) : c;
    return c * faces[f].refl.xyz;
}

// CalcRayAmbientLighting, style 0 only
vec3 RayColor(vec3 start, vec3 delta) {
    lsStart = start, lsDelta = delta, lsSurface = -1, lsHitfrac = 1.0, lsHasLuxel = false;
    if (Walk() != 0 || lsSurface < 0) return vec3(0.0);
    int f = lsSurface;
    float len = sqrt((delta.z * delta.z + delta.y * delta.y) + delta.x * delta.x);
    float avg = clamp((len * TAN_THETA * lsHitfrac - 20.0) * 0.05, 0.0, 1.0);
    if (!lsHasLuxel) avg = 1.0;
    float point = 1.0 - avg;
    vec3 col = vec3(0.0);
    bool sky = (faces[f].b.w & SURF_SKY) != 0;
    int lightofs = faces[f].a.x;
    if (avg != 0.0) {                       // (ColorFromAverage)
        if (sky) {
            if (pc.skylight.w != 0.0) col += SkyColor(delta) * avg;
        } else
            for (int m = 0; m < 4; m++) {
                int style = FaceStyle(f, m);
                if (style == 255) break;
                if (style >= 1) continue;
                col += FromSurface(f, Rgbe(lightofs - 4 * (m + 1)), delta) * avg;
            }
    }
    if (point != 0.0 && lightofs != -1) {   // (ColorPointSample)
        int page = faces[f].a.z * faces[f].a.w * faces[f].b.z;
        int lm = LuxelOffset(f, lsLuxel);
        for (int m = 0; m < 4; m++, lm += 4 * page) {
            int style = FaceStyle(f, m);
            if (style == 255) break;
            vec3 c = FromSurface(f, Rgbe(lm), delta);
            if (style < 1) col += c * point;
        }
    }
    return col;
}

const vec3 boxdir[6] = vec3[6](vec3(1, 0, 0), vec3(-1, 0, 0), vec3(0, 1, 0), vec3(0, -1, 0), vec3(0, 0, 1), vec3(0, 0, -1));

void main() {
    int i = int(gl_GlobalInvocationID.x);
    if (i >= pc.npoints) return;
    wFix = pc.fix != 0;
    vec3 start = vec3(points[3 * i], points[3 * i + 1], points[3 * i + 2]);
    vec3 rad[162];
    for (int r = 0; r < 162; r++) rad[r] = RayColor(start, (start + anorms[r].xyz * RAY_LENGTH) - start);
    for (int j = 5; j >= 0; j--) {
        float t = 0.0;
        vec3 cube = vec3(0.0);
        for (int r = 0; r < 162; r++) {
            float c = dot(anorms[r].xyz, boxdir[j]);
            if (c > 0.0) t += c, cube += rad[r] * c;
        }
        cube *= 1.0 / t;
        outv[18 * i + 3 * j] = cube.x, outv[18 * i + 3 * j + 1] = cube.y, outv[18 * i + 3 * j + 2] = cube.z;
    }
}
