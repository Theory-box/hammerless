vec3 previewDirect(vec3 samplePosition, vec3 n, int skyIndex, int skyCount, int areaPhase) {
        vec3 sum=vec3(0.0);
        
        for(int i=0;i<lightCount;i++) {
            int areaBatch=int(lights[i*5+4].w)-1;
            float areaWeight=1.0;
            if(areaPhase>=0 && areaBatch>=0) {
                if(areaPhase<8) {
                    if(areaBatch%8!=areaPhase) continue;
                    areaWeight=8.0;
                } else {
                    int count=max(1,int(lights[i*5+2].w));
                    if(areaBatch!=(areaPhase-8)%count) continue;
                    areaWeight=float(count);
                }
            }
            vec4 direction=lights[i*5+3];
            vec3 target=lights[i*5+0].xyz;
            if(direction.w==2.0) target=samplePosition-direction.xyz*(56755.84/unitScale);
            vec3 delta=(target-samplePosition)*unitScale;
            float lengthSquared=dot(delta,delta);
            if(lengthSquared<=0.0) continue;
            float d=max(sqrt(lengthSquared),1.0);
            vec3 a=lights[i*5+2].xyz;
            float cosine=max(dot(delta*inversesqrt(lengthSquared),n),0.0);
            if(direction.w==1.0) {
                vec3 cone=lights[i*5+4].xyz;
                float facing=-dot(delta*inversesqrt(lengthSquared),direction.xyz);
                if(facing<=cone.y) continue;
                float ramp=1.0;
                if(facing<cone.x) {
                    ramp=clamp((facing-cone.y)/(cone.x-cone.y),0.0,1.0);
                    if(cone.z!=0.0 && cone.z!=1.0) ramp=pow(ramp,float(int(4.0*cone.z))*0.25);
                }
                cosine*=ramp*facing;
            }
            if(cosine>0.0)cosine*=traceVisibility(samplePosition+n*(0.03125/unitScale),target);
            sum+=lights[i*5+1].xyz*(areaWeight*cosine/(a.z*d*d+a.y*d+a.x));
        }
        if(any(greaterThan(skyColor,vec3(0.0)))) {
            float weight=0.0, visibleWeight=0.0;
            for(int j=0;j<162;j++) {
                vec3 skyDirection=-skyDirections[j];
                float facing=dot(n,skyDirection);
                if(facing<=0.001) continue;
                weight+=facing;
                if(skyIndex>=0 && ((j-skyIndex+162)%162)>=skyCount)continue;
                float visibility=traceVisibility(samplePosition+n*(0.03125/unitScale),samplePosition+skyDirection*(56755.84/unitScale));
                visibleWeight+=facing*visibility*(skyIndex>=0?162.0/float(skyCount):1.0);
            }
            if(weight>0.0) sum+=skyColor*(visibleWeight/weight);
        }
        return sum;
    }
uint bounceHash(uint h) {
    h^=h>>16;h*=0x7feb352du;h^=h>>15;h*=0x846ca68bu;h^=h>>16;return h;
}
vec3 previewBounce(vec3 p,vec3 n) {
    if(bounceSamples<=0 || bounceSampleCount<=0)return vec3(0);
    vec3 sum=vec3(0);
    for(int localSample=0;localSample<bounceSampleCount;localSample++) {
        int j=((bounceSampleOffset+localSample)*bounceSampleStride)%bounceSamples;
        vec3 pathNormal=n,origin=p+n*(0.25/unitScale),throughput=vec3(1);
        for(int depth=0;depth<bounceDepth;depth++) {
        vec3 x=normalize(abs(pathNormal.z)<0.9?cross(pathNormal,vec3(0,0,1)):cross(pathNormal,vec3(1,0,0)));
        vec3 y=cross(pathNormal,x);
        float u=(float(j)+0.5)/float(bounceSamples);
        float v=float(bitfieldReverse(uint(j)))/4294967296.0;
        if(bounceSeed>0) {
            uint h=bounceHash(uint(bounceSeed)*6271u);
            u=fract(u+float(h&0xFFFFu)/65536.0);
            v=fract(v+float(h>>16)/65536.0);
        }
        if(depth>0) {
            uint h=bounceHash(uint(j)*9781u+uint(bounceSeed)*6271u+uint(depth)*13007u);
            u=float(h&0xFFFFu)/65536.0;v=float(h>>16)/65536.0;
        }
        float phi=6.28318530718*u,ct=sqrt(1.0-v),st=sqrt(v);
        vec3 d=x*(cos(phi)*st)+y*(sin(phi)*st)+pathNormal*ct;
        float distance;vec3 hn;vec2 bary;int tri,inst;
        if(!traceClosest(origin,d,56755.84/unitScale,distance,hn,bary,tri,inst))break;
        if(dot(hn,d)>=0.0)break;
        vec4 surface=surfaces[tri*2];
        if(surface.w<0.5)break;
        vec3 hit=origin+d*distance;
        // Uniform selection from the SAME 162 VRAD directions; previewDirect
        // keeps their full cosine normalization and multiplies this term by
        // 162. Expected sky illumination is unchanged, at greater variance.
        int skyIndex=bounceSkySampled!=0?int(bounceHash(uint(j)+uint(bounceSeed)*9781u+uint(depth)*13007u+719u)%162u):-1;
        // Independently select one sample per area emitter at each hit.
        // previewDirect weights by the emitter's sample count. Values >=8
        // encode this random selection; 0..7 are primary deterministic batches.
        int areaPhase=bounceAreaSampled!=0?8+int(bounceHash(uint(j)*271u+uint(bounceSeed)*65537u+uint(depth)*8191u+2917u)&0x3fffffffu):-1;
        throughput*=surface.rgb;
        sum+=previewDirect(hit+hn*(1.0/unitScale),hn,skyIndex,1,areaPhase)*throughput;
        pathNormal=hn;origin=hit+hn*(1.25/unitScale);
        }
    }
    return sum/float(bounceSampleCount);
}

void main() {
    uint i=gl_GlobalInvocationID.x;if(i>=pc.count)return;
    vec4 p=points[i*2];vec3 n=points[i*2+1].xyz;
    if(p.w<=0.0 || dot(n,n)<1e-20){result[i]=vec4(0);return;}
    n=normalize(n);
    int skyIndex=(pc.flags&1)!=0?(pc.seed*9)%162:-1;
    int areaPhase=(pc.flags&2)!=0?pc.seed%8:-1;
    vec3 value=previewDirect(p.xyz,n,skyIndex,9,areaPhase)+previewBounce(p.xyz,n);
    result[i]=vec4(value/255.0,1.0);
}
