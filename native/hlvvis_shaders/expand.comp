#version 460
// hlvvis -jacobi's expansion step on the GPU: one invocation per (base portal, frontier portal's snapshot, next
// portal q). It does what the CPU's round does for that q, operation for operation in the same order (`precise`: no
// fused multiply-adds), so the windows that come out are the CPU's, bit for bit:
//   pass   = q's winding chopped by the base's plane (whole if q is wholly in front)
//   source = the snapshot's S chopped by q's back plane (whole if the base is wholly behind q)
//   pass   = pass clipped by the separating planes of (source, W) and of (W, source) flipped
// Status per item: 0 nothing gets through, 1 a window (src, pass written).
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_spirv_intrinsics : require
// float controls pinned: round to nearest even on conversions (RoundingModeRTE 4462) and no rewriting of -0 / inf / NaN
// (SignedZeroInfNanPreserve 4461), for 32 and 64 bit floats, as the CPU does
spirv_execution_mode(4462, 32);
spirv_execution_mode(4462, 64);
spirv_execution_mode(4461, 32);
spirv_execution_mode(4461, 64);
layout(local_size_x = 64) in;

#define MAXW 64            // winding buffers (portal windings as read, merged hulls)
#define MAXCHOP int(pc.maxchop)   // a chop that would need more points keeps its input (the CPU's g_maxpts)

struct Portal { vec4 plane; vec4 origin; uint first; uint count; uint pad0; uint pad1; };   // origin.w = radius
struct Item { uint base; uint snap; uint q; uint pad; };
layout(std430, binding = 0) readonly buffer Points { vec4 pts[]; };
layout(std430, binding = 1) readonly buffer Portals { Portal portals[]; };
layout(std430, binding = 2) readonly buffer Items { Item items[]; };
layout(std430, binding = 3) readonly buffer SnapPts { vec4 snap_pts[]; };      // per snapshot: S (16) then W (16)
layout(std430, binding = 4) readonly buffer SnapN { uint snap_n[]; };          // per snapshot: S count, W count
layout(std430, binding = 5) writeonly buffer OutSrc { vec4 out_src[]; };       // per item: MAXW points
layout(std430, binding = 6) writeonly buffer OutPass { vec4 out_pass[]; };     // per item: MAXW points
layout(std430, binding = 7) writeonly buffer OutN { uint out_n[]; };           // per item: status, src n, pass n, 0

layout(push_constant) uniform PC { uint nitems; float eps_up; float len_lo; uint robust; uint snapcap; uint maxchop; } pc;

// windings in private arrays (a: the working pass, s: the working source, t: scratch)
vec3 A[MAXW]; int nA;
vec3 Sr[MAXW]; int nS;
vec3 Wp[MAXW]; int nW;
vec3 T[MAXW];

precise float dot3(vec3 p, vec3 n) {           // (p.x * n.x + p.y * n.y) + p.z * n.z, as the CPU's SSE and dotv
    precise float d = p.x * n.x + p.y * n.y;
    d = d + p.z * n.z;
    return d;
}

// chop the working pass A by plane (n, d): keep the front (points on the plane kept). Returns 0 if nothing is left,
// 1 if A changed or stayed (a chop needing more than MAXCHOP points keeps A as it was, like the CPU)
int chopA(vec3 n, float d) {
    float dists[MAXW + 1]; int sides[MAXW + 1];
    bool anyf = false, anyb = false;
    for (int i = 0; i < nA; i++) {
        precise float dd = dot3(A[i], n) - d;
        dists[i] = dd;
        if (dd >= pc.eps_up) { sides[i] = 0; anyf = true; }
        else if (dd <= -pc.eps_up) { sides[i] = 1; anyb = true; }
        else sides[i] = 2;
    }
    if (!anyb) return 1;
    if (!anyf) return 0;
    sides[nA] = sides[0]; dists[nA] = dists[0];
    int m = 0;
    for (int i = 0; i < nA; i++) {
        vec3 p1 = A[i];
        if (m == MAXCHOP) return 1;
        if (sides[i] == 2) { T[m++] = p1; continue; }
        if (sides[i] == 0) T[m++] = p1;
        if (sides[i + 1] == 2 || sides[i + 1] == sides[i]) continue;
        if (m == MAXCHOP) return 1;
        vec3 p2 = A[(i + 1) % nA]; precise vec3 mid;
        precise float den = dists[i] - dists[i + 1];
        precise float t = float(double(dists[i]) / double(den));   // (the CPU's correctly rounded float division: Vulkan's float divide may be 2.5 ulp off)
        mid.x = n.x == 1.0 ? d : n.x == -1.0 ? -d : p1.x + t * (p2.x - p1.x);
        mid.y = n.y == 1.0 ? d : n.y == -1.0 ? -d : p1.y + t * (p2.y - p1.y);
        mid.z = n.z == 1.0 ? d : n.z == -1.0 ? -d : p1.z + t * (p2.z - p1.z);
        T[m++] = mid;
    }
    for (int i = 0; i < m; i++) A[i] = T[i];
    nA = m;
    return 1;
}

// the same chop on the working source Sr
int chopS(vec3 n, float d) {
    float dists[MAXW + 1]; int sides[MAXW + 1];
    bool anyf = false, anyb = false;
    for (int i = 0; i < nS; i++) {
        precise float dd = dot3(Sr[i], n) - d;
        dists[i] = dd;
        if (dd >= pc.eps_up) { sides[i] = 0; anyf = true; }
        else if (dd <= -pc.eps_up) { sides[i] = 1; anyb = true; }
        else sides[i] = 2;
    }
    if (!anyb) return 1;
    if (!anyf) return 0;
    sides[nS] = sides[0]; dists[nS] = dists[0];
    int m = 0;
    for (int i = 0; i < nS; i++) {
        vec3 p1 = Sr[i];
        if (m == MAXCHOP) return 1;
        if (sides[i] == 2) { T[m++] = p1; continue; }
        if (sides[i] == 0) T[m++] = p1;
        if (sides[i + 1] == 2 || sides[i + 1] == sides[i]) continue;
        if (m == MAXCHOP) return 1;
        vec3 p2 = Sr[(i + 1) % nS]; precise vec3 mid;
        precise float den = dists[i] - dists[i + 1];
        precise float t = float(double(dists[i]) / double(den));   // (the CPU's correctly rounded float division: Vulkan's float divide may be 2.5 ulp off)
        mid.x = n.x == 1.0 ? d : n.x == -1.0 ? -d : p1.x + t * (p2.x - p1.x);
        mid.y = n.y == 1.0 ? d : n.y == -1.0 ? -d : p1.y + t * (p2.y - p1.y);
        mid.z = n.z == 1.0 ? d : n.z == -1.0 ? -d : p1.z + t * (p2.z - p1.z);
        T[m++] = mid;
    }
    for (int i = 0; i < m; i++) Sr[i] = T[i];
    nS = m;
    return 1;
}

// The separating planes of (src, pas) (the CPU's sep_planes, one pass point at a time), each applied to the working
// pass A at once, in the CPU's order (source edges i, then pass points j). srcIsS: src is the working source Sr and
// pas is Wp; else src is Wp and pas is Sr (flipclip: the planes negated). Returns 0 if A is clipped away.
int clip_seps(bool srcIsS) {
    int ns = srcIsS ? nS : nW, np = srcIsS ? nW : nS;
    for (int i = 0; i < ns; i++) {
        int l = (i + 1) % ns;
        vec3 si = srcIsS ? Sr[i] : Wp[i];
        vec3 sl = srcIsS ? Sr[l] : Wp[l];
        precise vec3 V1 = vec3(sl.x - si.x, sl.y - si.y, sl.z - si.z);
        for (int j = 0; j < np; j++) {
            vec3 P = srcIsS ? Wp[j] : Sr[j];
            precise vec3 v2 = vec3(P.x - si.x, P.y - si.y, P.z - si.z);
            precise float nx = V1.y * v2.z - V1.z * v2.y;
            precise float ny = V1.z * v2.x - V1.x * v2.z;
            precise float nz = V1.x * v2.y - V1.y * v2.x;
            precise float len = nx * nx + ny * ny;
            len = len + nz * nz;
            if (len <= pc.len_lo) continue;
            precise double inv = 1.0lf / sqrt(double(len));
            float invf = float(inv);
            precise float fx = nx * invf, fy = ny * invf, fz = nz * invf;
            vec3 nrm = vec3(fx, fy, fz);
            precise float dist = dot3(P, nrm);
            // which side the source is on: its first decisive point (not the edge's two)
            int decided = 0; bool flip = false;
            for (int k = 0; k < ns && decided == 0; k++) {
                if (k == i || k == l) continue;
                vec3 sk = srcIsS ? Sr[k] : Wp[k];
                precise float dk = dot3(sk, nrm) - dist;
                if (dk <= -pc.eps_up) decided = 1;
                else if (dk >= pc.eps_up) { decided = 1; flip = true; }
            }
            if (decided == 0) continue;                         // planar with the source: skip
            if (flip) { nrm = -nrm; dist = -dist; }
            bool bad = false, front = false;
            if (pc.robust != 0u) {
                // every source point behind or on the plane (merged hulls' hair-length edges)
                for (int k = 0; k < ns; k++) {
                    if (k == i || k == l) continue;
                    vec3 sk = srcIsS ? Sr[k] : Wp[k];
                    precise float dk = dot3(sk, nrm) - dist;
                    if (dk >= pc.eps_up) bad = true;
                }
            }
            // every other pass point on or in front, at least one in front
            for (int k = 0; k < np; k++) {
                if (k == j) continue;
                vec3 pk = srcIsS ? Wp[k] : Sr[k];
                precise float dk = dot3(pk, nrm) - dist;
                if (dk <= -pc.eps_up) bad = true;
                if (dk >= pc.eps_up) front = true;
            }
            if (bad || !front) continue;
            if (!srcIsS) { nrm = -nrm; dist = -dist; }          // flipclip
            if (chopA(nrm, dist) == 0) return 0;
        }
    }
    return 1;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.nitems) return;
    Item it = items[id];
    Portal b = portals[it.base], q = portals[it.q];
    out_n[4 * id] = 0u;
    // pass: q's winding chopped by the base's plane
    precise float dq = dot3(q.origin.xyz, b.plane.xyz) - b.plane.w;
    if (dq < -q.origin.w) return;
    nA = int(q.count);
    for (int i = 0; i < nA; i++) A[i] = pts[q.first + uint(i)].xyz;
    if (!(dq > q.origin.w)) { if (chopA(b.plane.xyz, b.plane.w) == 0) return; }
    // source: S chopped by q's back plane
    uint sb = it.snap * 2u * pc.snapcap;
    nS = int(snap_n[2u * it.snap]);
    nW = int(snap_n[2u * it.snap + 1u]);
    for (int i = 0; i < nS; i++) Sr[i] = snap_pts[sb + uint(i)].xyz;
    for (int i = 0; i < nW; i++) Wp[i] = snap_pts[sb + pc.snapcap + uint(i)].xyz;
    precise float db = dot3(b.origin.xyz, q.plane.xyz) - q.plane.w;
    if (db > b.origin.w) return;
    if (!(db < -b.origin.w)) {
        vec3 bn = -q.plane.xyz; float bd = -q.plane.w;
        if (chopS(bn, bd) == 0) return;
    }
    if (clip_seps(true) == 0) return;
    if (clip_seps(false) == 0) return;
    out_n[4 * id] = 1u;
    out_n[4 * id + 1] = uint(nS);
    out_n[4 * id + 2] = uint(nA);
    for (int i = 0; i < nS; i++) out_src[id * MAXW + uint(i)] = vec4(Sr[i], 0.0);
    for (int i = 0; i < nA; i++) out_pass[id * MAXW + uint(i)] = vec4(A[i], 0.0);
}
