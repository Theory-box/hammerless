#version 460
// (self-test) the double precision operations the vis's clipping uses, for comparing the GPU's bits with the CPU's:
// a / b, sqrt(a), and the separator planes' normalisation: (float)(1.0 / sqrt((double)len)) for a float len.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { dvec2 ab[]; };
layout(std430, binding = 1) readonly buffer InF { float lens[]; };
layout(std430, binding = 2) writeonly buffer Out { dvec2 q[]; };
layout(std430, binding = 3) writeonly buffer OutF { float inv[]; };
layout(push_constant) uniform PC { uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    precise double a = ab[i].x, b = ab[i].y;
    precise double d = a / b;
    precise double s = sqrt(a);
    q[i] = dvec2(d, s);
    precise double l = double(lens[i]);
    precise double r = 1.0lf / sqrt(l);
    inv[i] = float(r);
}
