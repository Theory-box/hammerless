#version 460
// hlvvis -jacobi GPU pipeline: per item (slot, frontier portal x, x's k-th next portal q in the flood), the expansion
// step (expand_lib.glsl, the CPU's to the bit) from x's snapshot; what comes through is stored and linked to the
// (slot, q) list for the merge. Items from pc.item_start on (a pass that ran out of room goes on from the first item
// that found none: the merge takes only the items before it) up to pc.item_end (a pass's share: no single job runs long).
#extension GL_GOOGLE_include_directive : require
#include "pipe_common.glsl"
#include "expand_lib.glsl"
layout(local_size_x = 64) in;

void main() {
    uint id = gid() + pc.item_start;
    if (id >= cnt[C_T] || id >= pc.item_end) return;
    uint lo = 0u, hi = cnt[C_N] - 1u;           // the pair: the last one starting at or before id
    while (lo < hi) { uint mid = (lo + hi + 1u) / 2u; if (pairs[mid].y <= id) lo = mid; else hi = mid - 1u; }
    uvec4 pa = pairs[lo];
    uint s = pa.z, k = id - pa.y, off = slots[s].off, xi = off + pa.w;
    uint base = slots[s].base;
    uint x = front[off + (lo - slots[s].slotoff)];
    uvec2 L = leaves[portals[x].leaf];
    uint qn = 0u;
    for (uint j = 0u, m = 0u; j < L.y; j++) {
        uint c = lflist[L.x + j];
        if (!in_flood(s, c) || !jm_step(s, xi, c)) continue;
        if (m == k) { qn = c; break; }
        m++;
    }
    Portal b = portals[base], q = portals[qn];
    // pass: q's winding chopped by the base's plane
    precise float dq = dot3(q.origin.xyz, b.plane.xyz) - b.plane.w;
    if (dq < -q.origin.w) return;
    nA = int(q.count);
    for (int i = 0; i < nA; i++) A[i] = pts[q.first + uint(i)].xyz;
    if (!(dq > q.origin.w)) { if (chopA(b.plane.xyz, b.plane.w) == 0) return; }
    // source: the snapshot's S chopped by q's back plane
    int hw = sth[xi].w;
    nS = (hw >> 16) & 255;
    nW = (hw >> 24) & 255;
    for (int i = 0; i < nS; i++) Sr[i] = stPS[xi].p[i].xyz;
    for (int i = 0; i < nW; i++) Wp[i] = stPW[xi].p[i].xyz;
    precise float db = dot3(b.origin.xyz, q.plane.xyz) - q.plane.w;
    if (db > b.origin.w) return;
    if (!(db < -b.origin.w)) {
        vec3 bn = -q.plane.xyz; float bd = -q.plane.w;
        if (chopS(bn, bd) == 0) return;
    }
    if (clip_seps(true) == 0) return;
    if (clip_seps(false) == 0) return;
    uint np = uint(nS + nA);
    uint c = 0u, pt = 0u;                    // (the pass's first item: its own room)
    if (id != pc.item_start) {
        c = atomicAdd(cnt[C_CAND], 1u);
        pt = atomicAdd(cnt[C_PTS], np);
        if (c >= pc.candcap || pt + np > pc.ptcap) { atomicMin(cnt[C_FAIL], id); return; }
    }
    for (int i = 0; i < nS; i++) cpts[pt + uint(i)] = vec4(Sr[i], 0.0);
    for (int i = 0; i < nA; i++) cpts[pt + uint(nS + i)] = vec4(A[i], 0.0);
    uint idx = off + rank_of(s, qn);
    pr[idx].w = qn;                          // (every item into q writes the same value)
    uint old = atomicExchange(pr[idx].x, c);
    cands[c] = uvec4(old, id, pt, uint(nS) | (uint(nA) << 16));
    candx[c] = xi;
    atomicAdd(tlen[idx], 1u);
    if (old == EMPTY) touched[atomicAdd(cnt[C_TOUCH], 1u)] = uvec2(idx, s);
}
