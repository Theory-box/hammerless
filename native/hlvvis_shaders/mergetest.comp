#version 460
// (self-test) j_merge's rule on the GPU (merge_core.glsl) for merges recorded from a CPU run: one invocation per
// record, the state after written back for the CPU to compare bit for bit.
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_GOOGLE_include_directive : require
spirv_execution_mode(4462, 32);
spirv_execution_mode(4462, 64);
spirv_execution_mode(4461, 32);
spirv_execution_mode(4461, 64);
layout(local_size_x = 64) in;

layout(push_constant) uniform PC { uint n; uint cap; } pc;
#define MERGE_HULL_CAP int(pc.cap)
#define MERGE_CAPDIR_BINDING 2
#include "merge_core.glsl"

// a record: flags (inited, opened, grows, 0), base normal + ccw, portal normal + ccw, counts (S, W, src, pass), then
// S[16], W[16], src[64], pass[64] points (vec4)
struct Rec { ivec4 flags; vec4 bn; vec4 pn; ivec4 counts; vec4 S[16]; vec4 W[16]; vec4 src[64]; vec4 pas[64]; };
struct Res { ivec4 flags; ivec4 counts; vec4 S[16]; vec4 W[16]; };     // flags: grew, opened, grows, inited
layout(std430, binding = 0) readonly buffer Recs { Rec recs[]; };
layout(std430, binding = 1) writeonly buffer Ress { Res ress[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    MS_n[0] = recs[i].counts.x; MS_n[1] = recs[i].counts.y; MC_n[0] = recs[i].counts.z; MC_n[1] = recs[i].counts.w;
    for (int k = 0; k < MS_n[0]; k++) MS[0][k] = recs[i].S[k].xyz;
    for (int k = 0; k < MS_n[1]; k++) MS[1][k] = recs[i].W[k].xyz;
    for (int k = 0; k < MC_n[0]; k++) MC[0][k] = recs[i].src[k].xyz;
    for (int k = 0; k < MC_n[1]; k++) MC[1][k] = recs[i].pas[k].xyz;
    M_n[0] = recs[i].bn.xyz; M_ccw[0] = int(recs[i].bn.w); M_n[1] = recs[i].pn.xyz; M_ccw[1] = int(recs[i].pn.w);
    bool inited = recs[i].flags.x != 0, opened = recs[i].flags.y != 0;
    int grows = recs[i].flags.z;
    int op = !inited ? MERGE_SET : opened ? 0 : MERGE_GROW;
    if (!inited) { inited = true; grows = 0; opened = false; }
    bool grew = false;
    if (op != 0) [[dont_unroll]] for (int side = 0; side < 2; side++) if (merge_side(side, op)) grew = true;
    ress[i].flags = ivec4(grew ? 1 : 0, opened ? 1 : 0, grows, inited ? 1 : 0);
    ress[i].counts = ivec4(MS_n[0], MS_n[1], 0, 0);
    for (int k = 0; k < 16; k++) {
        ress[i].S[k] = vec4(k < MS_n[0] ? MS[0][k] : vec3(0), 0.0);
        ress[i].W[k] = vec4(k < MS_n[1] ? MS[1][k] : vec3(0), 0.0);
    }
}
